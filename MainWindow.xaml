<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="E6Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:E6Viewer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="View621"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Dynamic Tint Overlay to fine-tune translucency / transparency level -->
        <Grid
            x:Name="TintOverlayGrid"
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Opacity="0.15" />

        <TitleBar
            x:Name="AppTitleBar"
            Title="View621"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Explore"
                    IsSelected="True"
                    Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="PinnedNavItem"
                    Content="Pinned"
                    Tag="bookmarks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE718;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="PinnedBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SavedNavItem"
                    Content="Saved"
                    Tag="saved">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="SavedBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Grid Margin="0,4,0,12">
                    <!-- Expanded View: Previous Searches box and Show Gender filter -->
                    <StackPanel x:Name="ExpandedSidebarPanel" Margin="12,0,12,0" Spacing="14">
                        <!-- Previous Searches section -->
                        <StackPanel x:Name="PreviousSearchesPanel" Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Previous searches" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button
                                    x:Name="ClearSearchHistoryButton"
                                    Grid.Column="1"
                                    Padding="4,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Clear history"
                                    Click="ClearSearchHistoryButton_Click">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- Prominent drag handle to resize the previous searches height (positioned above the list) -->
                            <Border
                                x:Name="SearchHistoryResizeHandle"
                                Height="14"
                                Margin="0,0,0,2"
                                Background="Transparent"
                                HorizontalAlignment="Stretch"
                                PointerPressed="SearchHistoryResizeHandle_PointerPressed"
                                PointerMoved="SearchHistoryResizeHandle_PointerMoved"
                                PointerReleased="SearchHistoryResizeHandle_PointerReleased"
                                PointerCaptureLost="SearchHistoryResizeHandle_PointerCaptureLost"
                                ToolTipService.ToolTip="Drag to resize previous searches">
                                <Border
                                    Width="48"
                                    Height="4"
                                    CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <!-- Scrollable container for previous search strings: resizable, defaults to 5 items (160px) -->
                            <Border
                                x:Name="SearchHistoryBorder"
                                Height="160"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="0">
                                <ScrollViewer
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="NoSearchesPlaceholder"
                                            Text="No recent searches"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Margin="8,12,8,12"
                                            HorizontalAlignment="Center"
                                            Visibility="Collapsed" />
                                        <ListView
                                            x:Name="SearchHistoryListView"
                                            SelectionMode="None"
                                            IsItemClickEnabled="True"
                                            ItemClick="SearchHistoryListView_ItemClick"
                                            Padding="0">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Height" Value="32" />
                                                    <Setter Property="MinHeight" Value="32" />
                                                    <Setter Property="Padding" Value="8,0" />
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Text="{Binding}"
                                                            FontSize="12"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="{Binding}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Padding="2"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Tag="{Binding}"
                                                            Click="DeleteSearchHistoryItem_Click"
                                                            ToolTipService.ToolTip="Remove this search">
                                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Rating filter: Safe, Questionable, Explicit (positioned above gender filter) -->
                        <StackPanel x:Name="ExpandedRatingPanel" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Rating" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                            <ComboBox
                                x:Name="SidebarRatingComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="SidebarRatingComboBox_SelectionChanged"
                                SelectedIndex="2">
                                <ComboBoxItem Content="Safe" Tag="Safe" ToolTipService.ToolTip="Safe only (rating:s)" />
                                <ComboBoxItem Content="Questionable" Tag="Questionable" ToolTipService.ToolTip="Questionable and safe (hides explicit)" />
                                <ComboBoxItem Content="Explicit" Tag="Explicit" ToolTipService.ToolTip="All ratings (safe, questionable, and explicit)" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Show gender filter -->
                        <StackPanel x:Name="ExpandedHideSexPanel" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE71C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Show gender" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                            <ComboBox
                                x:Name="SidebarHideSexComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="SidebarHideSexComboBox_SelectionChanged"
                                SelectedIndex="0">
                                <ComboBoxItem Content="All" Tag="All" />
                                <ComboBoxItem Content="Male" Tag="Male" />
                                <ComboBoxItem Content="Female" Tag="Female" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Collapsed View: Icons for Previous Searches, Rating, and Gender Filter, non-clickable indicators -->
                    <StackPanel
                        x:Name="CollapsedSidebarIndicators"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Grid
                            Height="36"
                            Width="48"
                            ToolTipService.ToolTip="Previous searches">
                            <FontIcon
                                Glyph="&#xE81C;"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                        <Grid
                            Height="36"
                            Width="48"
                            ToolTipService.ToolTip="Rating filter">
                            <FontIcon
                                Glyph="&#xE7BA;"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                        <Grid
                            Height="36"
                            Width="48"
                            ToolTipService.ToolTip="Show gender">
                            <FontIcon
                                Glyph="&#xE71C;"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </NavigationView.PaneFooter>

            <Grid>
                <!-- Main TabView for multi-tab browsing -->
                <TabView
                    x:Name="MainTabView"
                    AddTabButtonClick="MainTabView_AddTabButtonClick"
                    TabCloseRequested="MainTabView_TabCloseRequested"
                    IsAddTabButtonVisible="True"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch" />

                <!-- Standalone Frame for Settings and About pages -->
                <Frame x:Name="NavFrame" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
