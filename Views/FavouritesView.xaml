<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="View621.Views.FavouritesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:View621.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SeriesBadgeBackgroundBrush" Color="#E1F0FA" />
                    <SolidColorBrush x:Key="SeriesBadgeBorderBrush" Color="#B8D9F2" />
                    <SolidColorBrush x:Key="SeriesBadgeForegroundBrush" Color="#0B60B0" />

                    <SolidColorBrush x:Key="PoolBadgeBackgroundBrush" Color="#E3F2FD" />
                    <SolidColorBrush x:Key="PoolBadgeBorderBrush" Color="#BBDEFB" />
                    <SolidColorBrush x:Key="PoolBadgeForegroundBrush" Color="#1565C0" />

                    <SolidColorBrush x:Key="ChildBadgeBackgroundBrush" Color="#E8F5E9" />
                    <SolidColorBrush x:Key="ChildBadgeBorderBrush" Color="#C8E6C9" />
                    <SolidColorBrush x:Key="ChildBadgeForegroundBrush" Color="#2E7D32" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SeriesBadgeBackgroundBrush" Color="#1E2A38" />
                    <SolidColorBrush x:Key="SeriesBadgeBorderBrush" Color="#2A3D52" />
                    <SolidColorBrush x:Key="SeriesBadgeForegroundBrush" Color="#7BB3E8" />

                    <SolidColorBrush x:Key="PoolBadgeBackgroundBrush" Color="#162A3F" />
                    <SolidColorBrush x:Key="PoolBadgeBorderBrush" Color="#234363" />
                    <SolidColorBrush x:Key="PoolBadgeForegroundBrush" Color="#64B5F6" />

                    <SolidColorBrush x:Key="ChildBadgeBackgroundBrush" Color="#1B2E21" />
                    <SolidColorBrush x:Key="ChildBadgeBorderBrush" Color="#2A4533" />
                    <SolidColorBrush x:Key="ChildBadgeForegroundBrush" Color="#81C784" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid RowSpacing="16" Padding="28,20,28,16" Background="{ThemeResource SearchPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Title, Subtitle, and Refresh -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE734;" FontSize="20" />
                    <TextBlock Text="Favourites" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock
                    x:Name="HeaderSubtitleText"
                    Text="Your favourited posts on e621"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh favourites">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <StackPanel
                x:Name="LoadingPanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock
                    Text="Loading your favourites from e621..."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Not Logged In State -->
            <StackPanel
                x:Name="NotLoggedInPanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="16"
                Visibility="Collapsed"
                MaxWidth="440">
                <Border
                    Width="72"
                    Height="72"
                    CornerRadius="36"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE77B;"
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    Text="Login Required"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Viewing and managing your e621 favourites requires logging in with your username and API key."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    Content="Open Settings"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"
                    Click="OpenSettingsButton_Click">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;" FontSize="14" />
                                <TextBlock Text="Open Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>

            <!-- Empty State -->
            <StackPanel
                x:Name="EmptyStatePanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="14"
                Visibility="Collapsed"
                MaxWidth="420">
                <Border
                    Width="72"
                    Height="72"
                    CornerRadius="36"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE734;"
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    Text="No favourites yet"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Posts you favourite on e621 or within View621 will appear here."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Favourites Posts Grid -->
            <ScrollViewer
                x:Name="GridScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <ItemsView
                        x:Name="FavouritesItemsView"
                        SelectionMode="None"
                        IsItemInvokedEnabled="True"
                        ItemInvoked="FavouritesItemsView_ItemInvoked">
                        <ItemsView.Layout>
                            <UniformGridLayout
                                MinItemWidth="220"
                                MinItemHeight="280"
                                MinRowSpacing="12"
                                MinColumnSpacing="12"
                                ItemsStretch="Fill"
                                ItemsJustification="SpaceEvenly" />
                        </ItemsView.Layout>
                        <ItemsView.ItemTemplate>
                            <DataTemplate x:DataType="models:ImagePost">
                                <ItemContainer Tapped="ItemContainer_Tapped">
                                    <Grid
                                        Tapped="Card_Tapped"
                                        PointerPressed="Card_PointerPressed"
                                        Height="285"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Open in new tab" Tag="{x:Bind}" Click="CardOpenInNewTab_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8A7;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copy image link" Tag="{x:Bind}" Click="CardCopyLink_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Remove from favourites" Tag="{x:Bind}" Click="CardRemoveFavourite_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="185" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Thumbnail Image -->
                                        <Border
                                            Grid.Row="0"
                                            CornerRadius="8,8,0,0"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <Grid>
                                                <!-- Fallback icon -->
                                                <FontIcon
                                                    Glyph="&#xEB9F;"
                                                    FontSize="28"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />

                                                <!-- Thumbnail downloading indicator -->
                                                <ProgressRing
                                                    Width="24"
                                                    Height="24"
                                                    IsActive="True"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />

                                                <Image
                                                    Stretch="UniformToFill"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    ImageOpened="Thumbnail_ImageOpened"
                                                    ImageFailed="Thumbnail_ImageFailed">
                                                    <Image.Source>
                                                        <BitmapImage
                                                            UriSource="{x:Bind EffectivePreviewUri, Mode=OneTime}"
                                                            DecodePixelWidth="300"
                                                            DecodePixelType="Logical" />
                                                    </Image.Source>
                                                </Image>

                                                <!-- Remove Favourite Overlay Button on Thumbnail -->
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="6"
                                                    Width="30"
                                                    Height="30"
                                                    Padding="0"
                                                    CornerRadius="15"
                                                    Background="#CCBE185D"
                                                    BorderThickness="1"
                                                    BorderBrush="#FFBE185D"
                                                    Opacity="1.0"
                                                    Tag="{x:Bind}"
                                                    Click="CardRemoveFavouriteButton_Click"
                                                    Tapped="CardRemoveFavouriteButton_Tapped"
                                                    PointerPressed="CardRemoveFavouriteButton_PointerPressed"
                                                    ToolTipService.ToolTip="Remove from favourites">
                                                    <FontIcon
                                                        Glyph="&#xE735;"
                                                        FontSize="13"
                                                        Foreground="White" />
                                                </Button>

                                            </Grid>
                                        </Border>

                                        <!-- Metadata Footer -->
                                        <Grid Grid.Row="1" Padding="12,10" RowSpacing="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Artist & ID -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind Artist, Mode=OneTime}"
                                                    FontWeight="SemiBold"
                                                    FontSize="13"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind DisplayName, Mode=OneTime}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Score & Favourites -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE74A;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Score, Mode=OneTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE734;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind FavCount, Mode=OneTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </ItemContainer>
                            </DataTemplate>
                        </ItemsView.ItemTemplate>
                    </ItemsView>

                    <!-- Load More Button -->
                    <Button
                        x:Name="LoadMoreButton"
                        Content="Load more favourites"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,24"
                        Visibility="Collapsed"
                        Click="LoadMoreButton_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
