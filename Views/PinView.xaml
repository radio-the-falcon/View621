<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="E6Viewer.Views.PinView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:E6Viewer.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SeriesBadgeBackgroundBrush" Color="#E1F0FA" />
                    <SolidColorBrush x:Key="SeriesBadgeBorderBrush" Color="#B8D9F2" />
                    <SolidColorBrush x:Key="SeriesBadgeForegroundBrush" Color="#0B60B0" />

                    <SolidColorBrush x:Key="PoolBadgeBackgroundBrush" Color="#E3F2FD" />
                    <SolidColorBrush x:Key="PoolBadgeBorderBrush" Color="#BBDEFB" />
                    <SolidColorBrush x:Key="PoolBadgeForegroundBrush" Color="#1565C0" />

                    <SolidColorBrush x:Key="ChildBadgeBackgroundBrush" Color="#E8F5E9" />
                    <SolidColorBrush x:Key="ChildBadgeBorderBrush" Color="#C8E6C9" />
                    <SolidColorBrush x:Key="ChildBadgeForegroundBrush" Color="#2E7D32" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SeriesBadgeBackgroundBrush" Color="#1E2A38" />
                    <SolidColorBrush x:Key="SeriesBadgeBorderBrush" Color="#2A3D52" />
                    <SolidColorBrush x:Key="SeriesBadgeForegroundBrush" Color="#7BB3E8" />

                    <SolidColorBrush x:Key="PoolBadgeBackgroundBrush" Color="#162A3F" />
                    <SolidColorBrush x:Key="PoolBadgeBorderBrush" Color="#234363" />
                    <SolidColorBrush x:Key="PoolBadgeForegroundBrush" Color="#64B5F6" />

                    <SolidColorBrush x:Key="ChildBadgeBackgroundBrush" Color="#1B2E21" />
                    <SolidColorBrush x:Key="ChildBadgeBorderBrush" Color="#2A4533" />
                    <SolidColorBrush x:Key="ChildBadgeForegroundBrush" Color="#81C784" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid RowSpacing="16" Padding="28,20,28,16" Background="{ThemeResource SearchPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Title, Count, Refresh, and Clear -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE718;" FontSize="20" />
                    <TextBlock Text="Pinned" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock
                    x:Name="HeaderSubtitleText"
                    Text="Saved posts from your datastore"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh pinned posts">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button x:Name="ClearAllButton" ToolTipService.ToolTip="Clear all pinned posts">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                        <TextBlock Text="Clear all" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="10" Width="220">
                                <TextBlock Text="Clear all pinned posts?" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="This will remove all saved posts from your pinned datastore in ~/.umamiff."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button
                                    Content="Yes, clear all"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="ConfirmClearAll_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <StackPanel
                x:Name="LoadingPanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock
                    Text="Loading pinned posts from datastore..."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Empty State -->
            <StackPanel
                x:Name="EmptyStatePanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="14"
                Visibility="Collapsed"
                MaxWidth="420">
                <Border
                    Width="72"
                    Height="72"
                    CornerRadius="36"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE718;"
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    Text="No pinned posts yet"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Click the pin icon on any post in Explore or Detail view to save it to your pinned datastore."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    Content="Explore posts"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"
                    Click="ExploreButton_Click" />
            </StackPanel>

            <!-- Bookmarked Posts Grid -->
            <ScrollViewer
                x:Name="GridScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsView
                    x:Name="BookmarksItemsView"
                    ItemInvoked="BookmarksItemsView_ItemInvoked"
                    IsItemInvokedEnabled="True"
                    SelectionMode="None"
                    Padding="0,4,0,8">
                    <ItemsView.Layout>
                        <UniformGridLayout
                            MinItemWidth="220"
                            MinItemHeight="280"
                            MinRowSpacing="12"
                            MinColumnSpacing="12"
                            ItemsStretch="Fill"
                            ItemsJustification="SpaceEvenly" />
                    </ItemsView.Layout>
                    <ItemsView.ItemTemplate>
                        <DataTemplate x:DataType="models:ImagePost">
                            <ItemContainer Tapped="ItemContainer_Tapped">
                                <Grid
                                    Tapped="Card_Tapped"
                                    PointerPressed="Card_PointerPressed"
                                    Height="285"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open in new tab" Tag="{x:Bind}" Click="CardOpenInNewTab_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8A7;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy image link" Tag="{x:Bind}" Click="CardCopyLink_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Unpin post" Tag="{x:Bind}" Click="CardBookmark_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE840;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="185" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail Image with safe decode and error fallback -->
                                    <Border
                                        Grid.Row="0"
                                        CornerRadius="8,8,0,0"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <!-- Fallback icon -->
                                            <FontIcon
                                                Glyph="&#xEB9F;"
                                                FontSize="28"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />

                                            <!-- Thumbnail downloading indicator -->
                                            <ProgressRing
                                                Width="24"
                                                Height="24"
                                                IsActive="True"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />

                                            <Image
                                                Stretch="UniformToFill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ImageOpened="Thumbnail_ImageOpened"
                                                ImageFailed="Thumbnail_ImageFailed">
                                                <Image.Source>
                                                    <BitmapImage
                                                        UriSource="{x:Bind EffectivePreviewUri, Mode=OneTime}"
                                                        DecodePixelWidth="300"
                                                        DecodePixelType="Logical" />
                                                </Image.Source>
                                            </Image>

                                            <!-- Bookmark Button overlay on thumbnail -->
                                            <Button
                                                x:Name="CardBookmarkButton"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="6"
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                CornerRadius="15"
                                                Background="{x:Bind BookmarkButtonBackground, Mode=OneWay}"
                                                BorderThickness="1"
                                                BorderBrush="{x:Bind BookmarkButtonBorder, Mode=OneWay}"
                                                Opacity="1.0"
                                                Tag="{x:Bind}"
                                                Click="CardBookmarkButton_Click"
                                                Tapped="CardBookmarkButton_Tapped"
                                                PointerPressed="CardBookmarkButton_PointerPressed"
                                                ToolTipService.ToolTip="Unpin post">
                                                <FontIcon
                                                    Glyph="&#xE840;"
                                                    FontSize="12"
                                                    Foreground="{x:Bind BookmarkIconForeground, Mode=OneWay}" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Card Footer Info -->
                                    <Grid
                                        Grid.Row="1"
                                        Padding="10,6"
                                        RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Post Title with Badges -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="{x:Bind DisplayName, Mode=OneTime}"
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <!-- Media Type Badge (Video, GIF, Image) -->
                                                <Border
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="4,1"
                                                    ToolTipService.ToolTip="{x:Bind MediaTypeLabel, Mode=OneTime}">
                                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind MediaTypeGlyph, Mode=OneTime}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind MediaTypeLabel, Mode=OneTime}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Border>

                                                <Border
                                                    Visibility="{x:Bind IsInPool, Mode=OneTime}"
                                                    Background="{ThemeResource PoolBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource PoolBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Width="17"
                                                    Height="17">
                                                    <TextBlock
                                                        Text="P"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource PoolBadgeForegroundBrush}"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>

                                                <Border
                                                    Visibility="{x:Bind HasChildren, Mode=OneTime}"
                                                    Background="{ThemeResource ChildBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource ChildBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Width="17"
                                                    Height="17">
                                                    <TextBlock
                                                        Text="C"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource ChildBadgeForegroundBrush}"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{x:Bind Artist, Mode=OneTime}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind DimensionText, Mode=OneTime}"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Rating Badge, Score, and Favourites -->
                                        <Grid Grid.Row="2" ColumnSpacing="8" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                <TextBlock
                                                    Text="{x:Bind Rating, Mode=OneTime}"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind ScoreText, Mode=OneTime}"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind FavouritesText, Mode=OneTime}"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>
                    </ItemsView.ItemTemplate>
                </ItemsView>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
