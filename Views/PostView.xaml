<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="View621.Views.PostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:View621.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:sys="using:System"
    mc:Ignorable="d">

    <Grid RowSpacing="12" Padding="24,16,24,20" Background="{ThemeResource SearchPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / Action bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Click="BackButton_Click" ToolTipService.ToolTip="Back to search">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>

            <!-- Previous and Next Post Navigation Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                <Button
                    x:Name="PreviousPostButton"
                    Click="PreviousPost_Click"
                    ToolTipService.ToolTip="Previous post (Left arrow)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        <TextBlock Text="Prev" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="NextPostButton"
                    Click="NextPost_Click"
                    ToolTipService.ToolTip="Next post (Right arrow)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Next" />
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Empty center column for header -->
            <Border Grid.Column="2" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="ResolutionToggleButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ToggleResolution_Click"
                    ToolTipService.ToolTip="Switch between Preview/Sample and Full Original Size">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE91B;" FontSize="14" />
                        <TextBlock x:Name="ResolutionButtonText" Text="Switch to full view" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BookmarkButton"
                    Click="BookmarkButton_Click"
                    ToolTipService.ToolTip="Pin post">
                    <FontIcon x:Name="BookmarkIcon" Glyph="&#xE718;" FontSize="14" />
                </Button>
                <Button Click="OpenInBrowser_Click" ToolTipService.ToolTip="Open post on website">
                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                </Button>
                <Button Click="CopyLink_Click" ToolTipService.ToolTip="Copy Image URL">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
                <Button Click="SaveImage_Click" ToolTipService.ToolTip="Download full file">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body: Viewer on Left, Resizable Splitter in Middle, Info Sidebar on Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="260" MaxWidth="650" />
            </Grid.ColumnDefinitions>

            <!-- Zoomable Image Viewport with Fit to view floating button -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Border
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid x:Name="ViewportContainer">
                        <ScrollViewer
                            x:Name="ImageScrollViewer"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollMode="Disabled"
                            ZoomMode="Enabled"
                            MinZoomFactor="0.1"
                            MaxZoomFactor="5.0"
                            PointerPressed="ImageScrollViewer_PointerPressed"
                            PointerMoved="ImageScrollViewer_PointerMoved"
                            PointerReleased="ImageScrollViewer_PointerReleased"
                            PointerCaptureLost="ImageScrollViewer_PointerCaptureLost"
                            PointerWheelChanged="ImageScrollViewer_PointerWheelChanged">
                            <ScrollViewer.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Copy image" Click="CopyImage_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy URL" Click="CopyLink_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE71B;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ScrollViewer.ContextFlyout>
                            <Image
                                x:Name="DetailImage"
                                Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ImageOpened="DetailImage_ImageOpened"
                                ImageFailed="DetailImage_ImageFailed" />
                        </ScrollViewer>

                        <!-- Media Player for Video posts (webm, mp4, etc.) -->
                        <MediaPlayerElement
                            x:Name="DetailMediaPlayer"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Stretch="Uniform"
                            AreTransportControlsEnabled="True">
                            <MediaPlayerElement.TransportControls>
                                <MediaTransportControls
                                    IsCompact="False"
                                    IsZoomButtonVisible="False"
                                    IsPlaybackRateButtonVisible="True" />
                            </MediaPlayerElement.TransportControls>
                        </MediaPlayerElement>

                        <!-- Loading Indicator while image/media downloads / decodes -->
                        <ProgressRing
                            x:Name="ImageLoadingRing"
                            IsActive="False"
                            Visibility="Collapsed"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Floating Fit to View Button in Top Right Corner above the image -->
                <Button
                    x:Name="FitToViewButton"
                    Click="FitToView_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12"
                    ToolTipService.ToolTip="Fit image to fully fill the viewing area"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CardBackgroundFillColorSecondary}" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CardBackgroundFillColorTertiary}" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource CardStrokeColorDefaultBrush}" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="FitIcon" Glyph="&#xE740;" FontSize="13" />
                        <TextBlock x:Name="FitButtonText" Text="Fit to view" FontSize="12" />
                    </StackPanel>
                </Button>

                <!-- Pool / Series Navigation Toolbar in Top Left (Post X/Y pill, auto-fading) -->
                <Border
                    x:Name="PoolToolbar"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="6"
                    Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock x:Name="PoolToolbarText" Text="Series" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Resizable Splitter Handle -->
            <controls:GridSplitter
                Grid.Column="1"
                Width="12"
                HorizontalAlignment="Center"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"
                Cursor="SizeWestEast" />

            <!-- Metadata Sidebar (Defaults to 260px) -->
            <ScrollViewer Grid.Column="2" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Post Summary Card -->
                    <Border
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="16">
                        <StackPanel Spacing="10">
                            <!-- Post Title and Artist relocated from header -->
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="{x:Bind Post.DisplayName, Mode=OneTime}"
                                    FontWeight="SemiBold"
                                    FontSize="16"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind Post.Artist, Mode=OneTime}"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <MenuFlyoutSeparator Margin="0,4" />

                            <Grid RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Post ID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Post.Id, Mode=OneTime}" />

                                <TextBlock Grid.Row="1" Text="Rating" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Post.Rating, Mode=OneTime}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="2" Text="Dimensions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Post.DimensionText, Mode=OneTime}" />

                                <TextBlock Grid.Row="3" Text="File Size" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Post.FileSizeFormatted, Mode=OneTime}" />

                                <TextBlock Grid.Row="4" Text="Score" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetadataScoreText" Grid.Row="4" Grid.Column="1" Text="{x:Bind Post.Score, Mode=OneTime}" />

                                <TextBlock Grid.Row="5" Text="Favourites" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetadataFavCountText" Grid.Row="5" Grid.Column="1" Text="{x:Bind Post.FavCount, Mode=OneTime}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Post Actions Card (Vote & Favourite) -->
                    <Border
                        x:Name="PostActionsCard"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Post Actions" FontWeight="SemiBold" FontSize="15" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Upvote Button -->
                                <Button
                                    x:Name="UpvoteButton"
                                    HorizontalAlignment="Stretch"
                                    Height="36"
                                    Click="UpvoteButton_Click"
                                    ToolTipService.ToolTip="Upvote (Score +1)">
                                    <FontIcon x:Name="UpvoteIcon" Glyph="&#xE74A;" FontSize="16" HorizontalAlignment="Center" />
                                </Button>

                                <!-- Downvote Button -->
                                <Button
                                    x:Name="DownvoteButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Height="36"
                                    Click="DownvoteButton_Click"
                                    ToolTipService.ToolTip="Downvote (Score -1)">
                                    <FontIcon x:Name="DownvoteIcon" Glyph="&#xE74B;" FontSize="16" HorizontalAlignment="Center" />
                                </Button>

                                <!-- Favourite / Unfavourite Button -->
                                <Button
                                    x:Name="PostFavButton"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    Height="36"
                                    Click="PostFavButton_Click"
                                    ToolTipService.ToolTip="Add to favourites">
                                    <FontIcon x:Name="PostFavIcon" Glyph="&#xE734;" FontSize="16" HorizontalAlignment="Center" />
                                </Button>
                            </Grid>

                            <!-- Inline notice if user is not logged in -->
                            <InfoBar
                                x:Name="ActionLoginNotice"
                                IsOpen="False"
                                Severity="Informational"
                                Title="Login required"
                                Message="Set your username and API key in Settings to vote and favourite posts." />
                        </StackPanel>
                    </Border>

                    <!-- Series and Relationships Card -->
                    <Border
                        x:Name="RelationshipsCard"
                        Visibility="Collapsed"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Series &amp; Variations" FontWeight="SemiBold" FontSize="16" />

                            <!-- Parent reference if post has a parent -->
                            <StackPanel x:Name="ParentSection" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="Parent post:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button
                                    Click="ParentButton_Click"
                                    PointerPressed="ParentButton_PointerPressed"
                                    HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                        <TextBlock x:Name="ParentButtonText" Text="Post #1234" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Pools list with View Pool button -->
                            <StackPanel x:Name="PoolsSection" Visibility="Collapsed" Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pools &amp; Comics:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Button
                                        x:Name="SidebarViewPoolButton"
                                        Grid.Column="1"
                                        Click="OpenPoolFull_Click"
                                        ToolTipService.ToolTip="Open full pool in new tab"
                                        Padding="6,2"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="10" />
                                            <TextBlock Text="View pool" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl x:Name="PoolsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:E621PoolDto">
                                            <Button Click="PoolButton_Click" Tag="{x:Bind Id}" Margin="0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE838;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" />
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Children list -->
                            <StackPanel x:Name="ChildrenSection" Visibility="Collapsed" Spacing="6">
                                <TextBlock Text="Child variations:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsControl x:Name="ChildrenItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:Int64">
                                            <Button
                                                Click="ChildButton_Click"
                                                PointerPressed="ChildButton_PointerPressed"
                                                Tag="{x:Bind}"
                                                Margin="0,2"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEB9F;" FontSize="12" />
                                                    <TextBlock Text="{x:Bind}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Clickable Tags Card -->
                    <Border
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Tags" FontWeight="SemiBold" FontSize="16" />

                            <TextBlock Text="Artist" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{x:Bind Post.ArtistTags, Mode=OneTime}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Click="TagChip_Click" Tag="{x:Bind}" Margin="0,2" Padding="6,2" HorizontalAlignment="Left" CornerRadius="4">
                                            <Button.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Open" Tag="{x:Bind}" Click="TagChipOpen_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE721;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Open in new tab" Tag="{x:Bind}" Click="TagChipOpenInNewTab_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE737;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            <TextBlock Text="{x:Bind}" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Characters" FontSize="12" Foreground="#4CAF50" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{x:Bind Post.CharacterTags, Mode=OneTime}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Click="TagChip_Click" Tag="{x:Bind}" Margin="0,2" Padding="6,2" HorizontalAlignment="Left" CornerRadius="4">
                                            <Button.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Open" Tag="{x:Bind}" Click="TagChipOpen_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE721;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Open in new tab" Tag="{x:Bind}" Click="TagChipOpenInNewTab_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE737;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            <TextBlock Text="{x:Bind}" FontSize="12" Foreground="#4CAF50" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Species" FontSize="12" Foreground="#FF9800" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{x:Bind Post.SpeciesTags, Mode=OneTime}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Click="TagChip_Click" Tag="{x:Bind}" Margin="0,2" Padding="6,2" HorizontalAlignment="Left" CornerRadius="4">
                                            <Button.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Open" Tag="{x:Bind}" Click="TagChipOpen_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE721;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Open in new tab" Tag="{x:Bind}" Click="TagChipOpenInNewTab_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE737;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            <TextBlock Text="{x:Bind}" FontSize="12" Foreground="#FF9800" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="General" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{x:Bind Post.GeneralTags, Mode=OneTime}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Click="TagChip_Click" Tag="{x:Bind}" Margin="0,2" Padding="6,2" HorizontalAlignment="Left" CornerRadius="4">
                                            <Button.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Open" Tag="{x:Bind}" Click="TagChipOpen_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE721;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Open in new tab" Tag="{x:Bind}" Click="TagChipOpenInNewTab_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE737;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            <TextBlock Text="{x:Bind}" FontSize="12" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
