<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="View621.Views.SavedSearchesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:View621.Models"
    xmlns:vm="using:View621.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="PostThumbnailTemplate">
            <!-- Thumbnail Card -->
            <Button
                Padding="0"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                Tag="{Binding}"
                Click="Thumbnail_Click"
                ToolTipService.ToolTip="{Binding TagSummary}">
                <Grid Width="140" Height="140" CornerRadius="6">
                    <!-- Fallback icon -->
                    <FontIcon
                        Glyph="&#xEB9F;"
                        FontSize="24"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                    <!-- Post preview image -->
                    <Image
                        Stretch="UniformToFill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Image.Source>
                            <BitmapImage
                                UriSource="{Binding PreviewUri}"
                                DecodePixelWidth="200"
                                DecodePixelType="Logical" />
                        </Image.Source>
                    </Image>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="16" Padding="28,20,28,16" Background="{ThemeResource SearchPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Title, Subtitle, and Global Refresh button -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE74E;" FontSize="20" />
                    <TextBlock Text="Saved Searches" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock
                    Text="Quickly revisit your bookmarked searches and preview recent posts"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Global Refresh Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Click="RefreshButton_Click"
                    ToolTipService.ToolTip="Refresh all saved searches and update counts"
                    Height="34"
                    Padding="12,0"
                    CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content Area: List of Saved Search Cards or Empty State -->
        <Grid Grid.Row="1">
            <!-- Empty State when no searches are saved -->
            <StackPanel
                x:Name="EmptyStatePanel"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <FontIcon Glyph="&#xE74E;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="No saved searches yet"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Click the bookmark icon in the search bar on the Explore tab to save your favourite searches here."
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    MaxWidth="400" />
            </StackPanel>

            <!-- Saved Search Rows -->
            <ScrollViewer
                x:Name="RowsScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SavedSearchRowViewModel">
                            <!-- Card Container for each saved search -->
                            <Grid
                                Margin="0,0,0,16"
                                Padding="16,14,16,16"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Bar: Title, Count, See more posts, Delete -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Query Display Title (Bold, no pill) and light count text -->
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{x:Bind FormattedCount, Mode=OneWay}"
                                            FontSize="13"
                                            FontWeight="Normal"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,1,0,0" />
                                    </StackPanel>

                                    <!-- Right: Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- See more posts button -->
                                        <Button
                                            Content="See more posts"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Tag="{x:Bind}"
                                            Click="SeeMorePosts_Click"
                                            Height="32"
                                            Padding="12,0"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="Open full search in a new tab" />

                                        <!-- Delete saved search button (Segoe UI icon \uE74D) -->
                                        <Button
                                            Tag="{x:Bind}"
                                            Click="DeleteSavedSearch_Click"
                                            ToolTipService.ToolTip="Delete saved search"
                                            Height="32"
                                            Padding="8,0"
                                            CornerRadius="4">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Row: Horizontal ScrollViewer of post thumbnails -->
                                <Grid Grid.Row="1" MinHeight="140">
                                    <!-- Loading indicator for this row -->
                                    <ProgressRing
                                        IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                    <ScrollViewer
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Disabled"
                                        HorizontalScrollMode="Enabled"
                                        VerticalScrollMode="Disabled">
                                        <ItemsControl
                                            ItemsSource="{x:Bind PreviewPosts, Mode=OneWay}"
                                            ItemTemplate="{StaticResource PostThumbnailTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
