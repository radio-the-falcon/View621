<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="E6Viewer.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:E6Viewer.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Subtle tinted badge backgrounds for light mode -->
                    <SolidColorBrush x:Key="SeriesBadgeBackgroundBrush" Color="#E1F0FA" />
                    <SolidColorBrush x:Key="SeriesBadgeBorderBrush" Color="#B8D9F2" />
                    <SolidColorBrush x:Key="SeriesBadgeForegroundBrush" Color="#0B60B0" />

                    <SolidColorBrush x:Key="PoolBadgeBackgroundBrush" Color="#E3F2FD" />
                    <SolidColorBrush x:Key="PoolBadgeBorderBrush" Color="#BBDEFB" />
                    <SolidColorBrush x:Key="PoolBadgeForegroundBrush" Color="#1565C0" />

                    <SolidColorBrush x:Key="ChildBadgeBackgroundBrush" Color="#E8F5E9" />
                    <SolidColorBrush x:Key="ChildBadgeBorderBrush" Color="#C8E6C9" />
                    <SolidColorBrush x:Key="ChildBadgeForegroundBrush" Color="#2E7D32" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- Muted dark badge backgrounds close to the dark card surface -->
                    <SolidColorBrush x:Key="SeriesBadgeBackgroundBrush" Color="#1E2A38" />
                    <SolidColorBrush x:Key="SeriesBadgeBorderBrush" Color="#2A3D52" />
                    <SolidColorBrush x:Key="SeriesBadgeForegroundBrush" Color="#7BB3E8" />

                    <SolidColorBrush x:Key="PoolBadgeBackgroundBrush" Color="#162A3F" />
                    <SolidColorBrush x:Key="PoolBadgeBorderBrush" Color="#234363" />
                    <SolidColorBrush x:Key="PoolBadgeForegroundBrush" Color="#64B5F6" />

                    <SolidColorBrush x:Key="ChildBadgeBackgroundBrush" Color="#1B2E21" />
                    <SolidColorBrush x:Key="ChildBadgeBorderBrush" Color="#2A4533" />
                    <SolidColorBrush x:Key="ChildBadgeForegroundBrush" Color="#81C784" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid RowSpacing="14" Padding="28,20,28,16" Background="{ThemeResource SearchPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search Bar and Header Actions -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Refresh button positioned to the left of the search bar -->
            <Button
                Grid.Column="0"
                VerticalAlignment="Center"
                Height="32"
                Padding="10,0"
                CornerRadius="4"
                Click="RefreshButton_Click"
                ToolTipService.ToolTip="Refresh search results (F5)">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
            </Button>

            <!-- Search bar with default native clear button -->
            <AutoSuggestBox
                Grid.Column="1"
                x:Name="SearchBox"
                PlaceholderText="Search tags (e.g. canine rating:s)..."
                QueryIcon="{x:Null}"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                ItemsSource="{x:Bind ViewModel.TagSuggestions, Mode=OneWay}"
                UpdateTextOnSelect="False"
                TextChanged="SearchBox_TextChanged"
                SuggestionChosen="SearchBox_SuggestionChosen"
                QuerySubmitted="SearchBox_QuerySubmitted"
                PreviewKeyDown="SearchBox_PreviewKeyDown"
                VerticalAlignment="Center" />

            <!-- Separate search action button positioned to the right of the search bar -->
            <Button
                Grid.Column="2"
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Center"
                Height="32"
                Padding="12,0"
                CornerRadius="4"
                Click="SearchButton_Click"
                ToolTipService.ToolTip="Search (Enter)">
                <FontIcon Glyph="&#xE721;" FontSize="14" />
            </Button>

            <!-- Sort options: these add an order: term to the query without showing it in the search box -->
            <DropDownButton Grid.Column="3" ToolTipService.ToolTip="Sort results">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortFlyout" Placement="BottomEdgeAlignedRight">
                        <RadioMenuFlyoutItem x:Name="SortDefaultItem" Text="Default (Newest ID first)" Tag="id" GroupName="SortGroup" Click="SortItem_Click" />
                        <RadioMenuFlyoutItem x:Name="SortCreatedItem" Text="Date created (Newest first)" Tag="created" GroupName="SortGroup" Click="SortItem_Click" />
                        <RadioMenuFlyoutItem x:Name="SortScoreItem" Text="Score (Highest first)" Tag="score" GroupName="SortGroup" Click="SortItem_Click" />
                        <RadioMenuFlyoutItem x:Name="SortFavCountItem" Text="Favourites (Most first)" Tag="favcount" GroupName="SortGroup" Click="SortItem_Click" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="SortReverseItem" Text="Reverse order (Ascending)" Click="SortReverse_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- Save search button at the very right of the search bar controls -->
            <Button
                Grid.Column="4"
                x:Name="SaveSearchButton"
                Click="SaveSearchButton_Click"
                ToolTipService.ToolTip="Save this search"
                VerticalAlignment="Center"
                Height="32"
                Padding="10,0"
                CornerRadius="4">
                <FontIcon x:Name="SaveSearchIcon" Glyph="&#xE74E;" FontSize="13" />
            </Button>
        </Grid>

        <!-- Suggested Quick Tags / Filters -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    Text="Quick filters:"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,0,4,0" />
                <Button Content="order:score" Click="TagChip_Click" Tag="order:score" CornerRadius="12" Padding="10,3" />
                <Button Content="rating:s" Click="TagChip_Click" Tag="rating:s" CornerRadius="12" Padding="10,3" />
                <Button Content="scenery" Click="TagChip_Click" Tag="scenery" CornerRadius="12" Padding="10,3" />
                <Button Content="canine" Click="TagChip_Click" Tag="canine" CornerRadius="12" Padding="10,3" />
                <Button Content="feline" Click="TagChip_Click" Tag="feline" CornerRadius="12" Padding="10,3" />
                <Button Content="dragon" Click="TagChip_Click" Tag="dragon" CornerRadius="12" Padding="10,3" />
            </StackPanel>
        </ScrollViewer>

        <!-- Main Content: Loading or Grid -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock
                    Text="Loading images from provider..."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Image Grid using ItemsView with UniformGridLayout for even distribution -->
            <ItemsView
                    x:Name="ImagesItemsView"
                    ItemsSource="{x:Bind ViewModel.Posts, Mode=OneWay}"
                    ItemInvoked="ImagesItemsView_ItemInvoked"
                    IsItemInvokedEnabled="True"
                    SelectionMode="None"
                    Padding="0,4,0,8">
                    <ItemsView.Layout>
                        <UniformGridLayout
                            MinItemWidth="220"
                            MinItemHeight="280"
                            MinRowSpacing="12"
                            MinColumnSpacing="12"
                            ItemsStretch="Fill"
                            ItemsJustification="SpaceEvenly" />
                    </ItemsView.Layout>
                    <ItemsView.ItemTemplate>
                        <DataTemplate x:DataType="models:ImagePost">
                            <ItemContainer Tapped="ItemContainer_Tapped">
                                <Grid
                                    Tapped="Card_Tapped"
                                    PointerPressed="Card_PointerPressed"
                                    Height="285"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open in new tab" Tag="{x:Bind}" Click="CardOpenInNewTab_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8A7;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy image link" Tag="{x:Bind}" Click="CardCopyLink_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="{x:Bind BookmarkTooltip, Mode=OneWay}" Tag="{x:Bind}" Click="CardBookmark_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="{x:Bind BookmarkGlyph, Mode=OneWay}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="185" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail Image with safe decode and error fallback -->
                                    <Border
                                        Grid.Row="0"
                                        CornerRadius="8,8,0,0"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <!-- Fallback icon -->
                                            <FontIcon
                                                Glyph="&#xEB9F;"
                                                FontSize="28"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />

                                            <!-- Thumbnail downloading indicator -->
                                            <ProgressRing
                                                Width="24"
                                                Height="24"
                                                IsActive="True"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />

                                            <Image
                                                Stretch="UniformToFill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ImageOpened="Thumbnail_ImageOpened"
                                                ImageFailed="Thumbnail_ImageFailed">
                                                <Image.Source>
                                                    <BitmapImage
                                                        UriSource="{x:Bind PreviewUri, Mode=OneTime}"
                                                        DecodePixelWidth="300"
                                                        DecodePixelType="Logical" />
                                                </Image.Source>
                                            </Image>

                                            <!-- Bookmark Button overlay on thumbnail -->
                                            <Button
                                                x:Name="CardBookmarkButton"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="6"
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                CornerRadius="15"
                                                Background="{x:Bind BookmarkButtonBackground, Mode=OneWay}"
                                                BorderThickness="1"
                                                BorderBrush="{x:Bind BookmarkButtonBorder, Mode=OneWay}"
                                                Opacity="{x:Bind BookmarkOpacity, Mode=OneWay}"
                                                Tag="{x:Bind}"
                                                Click="CardBookmarkButton_Click"
                                                Tapped="CardBookmarkButton_Tapped"
                                                PointerPressed="CardBookmarkButton_PointerPressed"
                                                ToolTipService.ToolTip="{x:Bind BookmarkTooltip, Mode=OneWay}">
                                                <FontIcon
                                                    Glyph="{x:Bind BookmarkGlyph, Mode=OneWay}"
                                                    FontSize="12"
                                                    Foreground="{x:Bind BookmarkIconForeground, Mode=OneWay}" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Card Footer Info with Rating Badge below the thumbnail -->
                                    <Grid
                                        Grid.Row="1"
                                        Padding="10,6"
                                        RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Post Title with Series label, Blue P (Pool), and Red C (Children) badges -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="{x:Bind DisplayName, Mode=OneTime}"
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <!-- Media Type Badge (Video, GIF, Image) -->
                                                <Border
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="4,1"
                                                    ToolTipService.ToolTip="{x:Bind MediaTypeLabel, Mode=OneTime}">
                                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind MediaTypeGlyph, Mode=OneTime}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind MediaTypeLabel, Mode=OneTime}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Blue P Badge for Pool (subtle theme-aware blue) -->
                                                <Border
                                                    Visibility="{x:Bind IsInPool, Mode=OneTime}"
                                                    Background="{ThemeResource PoolBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource PoolBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Width="17"
                                                    Height="17">
                                                    <TextBlock
                                                        Text="P"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource PoolBadgeForegroundBrush}"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Green C Badge for Children / Subposts (subtle theme-aware green) -->
                                                <Border
                                                    Visibility="{x:Bind HasChildren, Mode=OneTime}"
                                                    Background="{ThemeResource ChildBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource ChildBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Width="17"
                                                    Height="17">
                                                    <TextBlock
                                                        Text="C"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource ChildBadgeForegroundBrush}"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{x:Bind Artist, Mode=OneTime}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind DimensionText, Mode=OneTime}"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Rating Badge, Score, and Favourites below the thumbnail -->
                                        <Grid Grid.Row="2" ColumnSpacing="8" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                <TextBlock
                                                    Text="{x:Bind Rating, Mode=OneTime}"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind ScoreText, Mode=OneTime}"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind FavouritesText, Mode=OneTime}"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>
                    </ItemsView.ItemTemplate>
                </ItemsView>
        </Grid>

        <!-- Pagination Bar at Bottom -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                    ToolTipService.ToolTip="Previous page">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock Text="Previous" />
                    </StackPanel>
                </Button>

                <Border
                    Padding="10,4"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock
                        Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
                        FontWeight="SemiBold" />
                </Border>

                <Button
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                    ToolTipService.ToolTip="Next page">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Next" />
                        <FontIcon Glyph="&#xE72A;" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
