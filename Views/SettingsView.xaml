<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="E6Viewer.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,24,28,32">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <!-- Appearance Section -->
            <StackPanel Spacing="6">
                <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
                <controls:SettingsCard
                    Header="App Theme"
                    Description="Select which app theme to display">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Use system setting" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Window Material"
                    Description="Choose between Mica and Desktop Acrylic backdrop">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE771;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="BackdropComboBox" SelectionChanged="BackdropComboBox_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Desktop Acrylic" Tag="Acrylic" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Translucency"
                    Description="Adjust the level of window transparency">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Slider
                            x:Name="TranslucencySlider"
                            Minimum="10"
                            Maximum="100"
                            StepFrequency="5"
                            Width="160"
                            ValueChanged="TranslucencySlider_ValueChanged" />
                        <TextBlock
                            x:Name="TranslucencyLabel"
                            VerticalAlignment="Center"
                            Width="36"
                            Text="85%" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <!-- Search & Provider Section -->
            <StackPanel Spacing="6">
                <TextBlock Text="Search &amp; API" Style="{StaticResource SubtitleTextBlockStyle}" />

                <controls:SettingsCard
                    Header="Images per page"
                    Description="Number of images to fetch per page">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF0E2;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="PageSizeComboBox" SelectionChanged="PageSizeComboBox_SelectionChanged" SelectedIndex="1">
                        <ComboBoxItem Content="24 images" Tag="24" />
                        <ComboBoxItem Content="40 images" Tag="40" />
                        <ComboBoxItem Content="75 images" Tag="75" />
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>

            <!-- Authentication Section -->
            <StackPanel Spacing="6">
                <TextBlock Text="Account &amp; API Credentials (Optional)" Style="{StaticResource SubtitleTextBlockStyle}" />
                <controls:SettingsCard
                    Header="Username"
                    Description="Your username on e621 / e926">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox x:Name="UsernameTextBox" Width="220" TextChanged="UsernameTextBox_TextChanged" PlaceholderText="Username" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="API Key"
                    Description="Generated from your e621 account settings page">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <PasswordBox x:Name="ApiKeyPasswordBox" Width="220" PasswordChanged="ApiKeyPasswordBox_PasswordChanged" PlaceholderText="API Key" />
                </controls:SettingsCard>
            </StackPanel>

            <!-- Data & Storage Section -->
            <StackPanel Spacing="6">
                <TextBlock Text="Data &amp; Storage" Style="{StaticResource SubtitleTextBlockStyle}" />
                <controls:SettingsCard
                    Header="Data Location"
                    Description="Local storage for cache, bookmarks, settings, and logs (~/.umamiff)">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xED25;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button x:Name="OpenDataFolderButton" Content="Open in File Explorer" Click="OpenDataFolderButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC50;" FontSize="14" />
                                    <TextBlock Text="Open folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
